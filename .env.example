# Copy to .env and adjust. All variables are prefixed EDI_.
EDI_DATABASE_URL=sqlite:///./data/metadata.db          # or postgresql+psycopg2://edi:edi@localhost:5432/edi
EDI_REDIS_URL=                                           # optional, e.g. redis://localhost:6379/0
EDI_SECRET_KEY=change-me-in-production-please            # JWT signing + derives the encryption key for stored credentials
EDI_ENCRYPTION_KEY=                                      # optional explicit Fernet key (base64, 32 bytes)
EDI_DATA_DIR=./data
EDI_CORS_ORIGINS=["http://localhost:3000"]
EDI_QUERY_TIMEOUT_SECONDS=30
EDI_MAX_RESULT_ROWS=5000
EDI_PROFILE_SAMPLE_ROWS=100000
EDI_AI_MAX_TOOL_ITERATIONS=12
EDI_AI_REQUEST_TIMEOUT_SECONDS=180
EDI_DEFAULT_ADMIN_EMAIL=admin@example.com
EDI_DEFAULT_ADMIN_PASSWORD=admin123
EDI_SCHEDULER_ENABLED=true
EDI_SCHEDULER_TICK_SECONDS=60

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
