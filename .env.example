# Copy to .env and adjust. All variables are prefixed EDI_.
# Security-relevant settings are explained in docs/security.md.

# --- Security --------------------------------------------------------------
# "production" makes the checks below FATAL: the app refuses to start on a default
# secret key, a default admin password, or a localhost CORS origin.
EDI_ENVIRONMENT=development

# Signs JWTs AND derives the Fernet key that encrypts every stored credential.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# Leave blank in development and one is generated into .env on first run.
# BACK THIS UP: losing it means re-entering every stored connector credential and API key.
EDI_SECRET_KEY=
EDI_ENCRYPTION_KEY=                                      # optional explicit Fernet key (base64, 32 bytes)

EDI_DEFAULT_ADMIN_EMAIL=admin@example.com
# Leave blank to have one generated and printed once on first run.
EDI_DEFAULT_ADMIN_PASSWORD=

EDI_CORS_ORIGINS=["http://localhost:3000"]

# Executes model-authored Python. The in-process guard is NOT a security boundary —
# it is escapable to host RCE. Enable only inside an isolated container. See docs/security.md.
EDI_PYTHON_ANALYSIS_ENABLED=false

# --- Data retention (GDPR Art. 5(1)(e) storage limitation) -----------------
EDI_QUERY_PREVIEW_RETENTION_DAYS=30    # stored result rows; the query text itself is kept
EDI_ANON_VAULT_RETENTION_HOURS=24      # de-anonymisation key material
EDI_AUDIT_RETENTION_DAYS=365

# --- Core ------------------------------------------------------------------
EDI_DATABASE_URL=sqlite:///./data/metadata.db          # or postgresql+psycopg2://edi:edi@localhost:5432/edi
EDI_REDIS_URL=                                           # optional, e.g. redis://localhost:6379/0
EDI_DATA_DIR=./data
EDI_QUERY_TIMEOUT_SECONDS=30
EDI_MAX_RESULT_ROWS=5000
EDI_PROFILE_SAMPLE_ROWS=100000
EDI_AI_MAX_TOOL_ITERATIONS=12
EDI_AI_REQUEST_TIMEOUT_SECONDS=180
EDI_SCHEDULER_ENABLED=true
EDI_SCHEDULER_TICK_SECONDS=60

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
